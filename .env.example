# Servidor
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Banco PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fhl

# Segurança
JWT_SECRET=troque-por-uma-chave-forte-com-mais-de-32-caracteres
BCRYPT_ROUNDS=12

# Google Workspace / Drive - preencher apenas na fase de integração real
GOOGLE_WORKSPACE_DOMAIN=seudominio.com.br
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Operacional
BACKUP_DIR=./backups


# Google OAuth / Login Google Workspace
GOOGLE_ALLOWED_DOMAIN=seudominio.com.br
GOOGLE_REQUIRE_HOSTED_DOMAIN=true
GOOGLE_LOGIN_SUCCESS_REDIRECT=http://localhost:3000/app.html
GOOGLE_LOGIN_FAILURE_REDIRECT=http://localhost:3000/?login=failed

# Cookies
AUTH_COOKIE_NAME=fhl_token
AUTH_COOKIE_SECURE=false


# Comercial / SaaS
SAAS_MODE=true
DEFAULT_PLAN=starter
DEFAULT_TRIAL_DAYS=14
PLATFORM_ADMIN_EMAIL=admin@seudominio.com.br

# Backup automático
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_CRON=0 3 * * *

# Cobrança - placeholder para gateway futuro
BILLING_PROVIDER=manual
BILLING_WEBHOOK_SECRET=

# Suporte
SUPPORT_EMAIL=suporte@seudominio.com.br

# Atualizações seguras
APP_VERSION=1.2.0
MIGRATIONS_LOCKED=true
