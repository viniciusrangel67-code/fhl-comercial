# FHL Comercial — Railway
# No Railway, adicione PostgreSQL ao projeto e use a variável DATABASE_URL do banco.

NODE_ENV=production
PORT=3000

# Troque depois pelo domínio público do Railway ou seu domínio próprio
APP_ORIGIN=https://SEU-PROJETO.up.railway.app

# O Railway deve preencher esta variável quando o PostgreSQL for adicionado.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Gere uma chave longa e guarde em segredo.
JWT_SECRET=troque-por-uma-chave-grande-com-mais-de-32-caracteres

AUTH_COOKIE_SECURE=true
SAAS_MODE=true
DEFAULT_PLAN=starter
DEFAULT_TRIAL_DAYS=14

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
